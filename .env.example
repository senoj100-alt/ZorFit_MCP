# ZorFit_MCP generic environment template
# Cloudflare Workers local development uses `.dev.vars`, so most users should
# copy `.dev.vars.example` instead of this file.

GITHUB_CLIENT_ID=replace_with_your_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_your_github_oauth_client_secret
GOOGLE_LOGIN_CLIENT_ID=replace_with_google_login_oauth_client_id
GOOGLE_LOGIN_CLIENT_SECRET=replace_with_google_login_oauth_client_secret
COOKIE_ENCRYPTION_KEY=replace_with_64_character_hex_string

HEVY_API_KEY=replace_with_hevy_api_key
STRAVA_CLIENT_ID=replace_with_strava_client_id
STRAVA_CLIENT_SECRET=replace_with_strava_client_secret
STRAVA_ACCESS_TOKEN=replace_with_strava_access_token
STRAVA_REFRESH_TOKEN=replace_with_strava_refresh_token
CRONOMETER_USERNAME=replace_with_cronometer_email
CRONOMETER_PASSWORD=replace_with_cronometer_password
INTERVALS_ICU_API_KEY=replace_with_intervals_icu_api_key
INTERVALS_ICU_ATHLETE_ID=replace_with_intervals_icu_athlete_id
FITBIT_CLIENT_ID=replace_with_fitbit_client_id
FITBIT_CLIENT_SECRET=replace_with_fitbit_client_secret
GOOGLE_FIT_CLIENT_ID=replace_with_google_fit_client_id
GOOGLE_FIT_CLIENT_SECRET=replace_with_google_fit_client_secret

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=replace_with_telegram_bot_username_without_at
TELEGRAM_WEBHOOK_SECRET=replace_with_optional_random_webhook_secret
